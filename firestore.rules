rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil del usuario y sus subcolecciones (savedTips): solo el dueño
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      // acceptedTermsAt, si viene, debe ser la hora del servidor (serverTimestamp): no se puede falsear.
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('acceptedTermsAt', request.time) == request.time;
      // La prueba de aceptación (Ley 1581 art. 17 b) se puede crear, pero no modificar una vez escrita.
      // Futuras re-aceptaciones (nueva versión de términos) van a users/{uid}/consents/{version}
      // (subcolección del dueño, ya permitida por la regla {sub}/{docId}), no sobrescribiendo este campo.
      allow update: if request.auth != null && request.auth.uid == userId
        && ((resource.data.get('acceptedTermsAt', null) == null
            && request.resource.data.get('acceptedTermsAt', request.time) == request.time)
          || (request.resource.data.get('acceptedTermsAt', null) == resource.data.acceptedTermsAt
            && request.resource.data.get('termsVersion', null) == resource.data.get('termsVersion', null)));

      match /{sub}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Mascotas: en create no existe resource.data, se valida el documento entrante
    match /pets/{petId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      // update: solo el dueño, y sin poder transferir la mascota a otro userId
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;

      // Las subcolecciones NO heredan permisos: se verifica la propiedad con get()
      match /vacunas/{id} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/pets/$(petId)).data.userId == request.auth.uid;
      }
      match /pesos/{id} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/pets/$(petId)).data.userId == request.auth.uid;
      }
      match /medicinas/{id} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/pets/$(petId)).data.userId == request.auth.uid;
      }
    }

    // Tips: lectura para usuarios autenticados; escritura solo por Firebase Console
    match /tips/{tipId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
